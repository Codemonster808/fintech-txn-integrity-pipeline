# Copy to .env (gitignored) or symlink to ~/.config/de-portfolio/.env
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# fake (default, free, deterministic) | minimax (real, costs money)
LLM_PROVIDER=fake
MINIMAX_API_KEY=

# chroma (default, free, local) | pinecone (real)
VECTOR_BACKEND=chroma
PINECONE_API_KEY=
